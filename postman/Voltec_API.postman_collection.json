    {
      "name": "Pedidos",
      "description": "Crear un pedido descuenta el stock dentro de una transacción.",
      "item": [
        {
          "name": "Crear pedido (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "Crea el pedido, calcula el envío en el servidor y descuenta el stock. La `Idempotency-Key` evita duplicados: repite esta petición sin cambiar la clave y responde 200 con el mismo pedido.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"producto_id\": \"{{producto_id}}\",\n      \"cantidad\": 1\n    }\n  ],\n  \"envio\": {\n    \"nombre\": \"Cliente Demo\",\n    \"telefono\": \"987654321\",\n    \"direccion\": \"Av. Giráldez 245\",\n    \"distrito\": \"Huancayo\",\n    \"referencia\": \"Frente al parque\"\n  },\n  \"pago\": {\n    \"metodo\": \"tarjeta\",\n    \"tarjeta_ultimos4\": \"4242\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('pedido_id', pm.response.json().id);"
